# Example bot configuration.
# Copy this into config.toml and fill in your RPC / key / sender modes.

[stop]
min_balance_lamports = 100_000_000
should_unwrap = true
unwrap_amount_lamports = 200_000_000

[cashback_autoclaim]
enabled = true
claim_threshold_lamports = 100_000_000
check_interval_secs = 3600

# Markets sources from file.
# File format: TOML where each [[group]] is one transaction:
# [[group]]
# mint_a = "..."
# markets_a = ["...", "..."]
# mint_b = "..."              # optional
# markets_b = ["...", "..."]  # required when mint_b is set
# luts = ["..."]
#
# If `update_seconds = 0`, the file is read once at startup.
# [[markets_file]]
# enabled = false
# path = "markets.toml"
# update_seconds = 0
# If true, LUTs from markets.toml are ignored and fresh LUTs are resolved through Arb-Assist every 5 seconds.
# auto_luts = false

# LUT sources from file.
# Supported formats:
# 1. TOML like `luts = ["..."]`
# 2. TXT where the first token on each line is a LUT address
# If `update_seconds = 0`, the file is read once at startup.
# [[lookup_tables_file]]
# enabled = false
# path = "lookup-tables.txt"
# update_seconds = 0

[bot]
# Compute unit limit per transaction
compute_unit_limit = 358_182
dlmm_bin_range_to_search = 20
gas_file = false
merge_mints = true
log = false

[DataSizeEstimation]
# If true, DataSizeLimit is estimated by simulation and added to transactions.
# If false, estimation is skipped and the instruction is not added.
enable = true

[dynamic_fees]
enabled = false
window_ms = 5_000
min_samples = 50
sample_scope = "all"

[spam]
enabled = true
process_delay = 300
sending_rpc_urls = [
  "",
]
priority_fee = { from = 1111, to = 10333 }
dynamic_priority_fee = { enable = true, min_percentile = 10, max_percentile = 85, min = 1111, max = 23333 }

[jito]
enabled = false
process_delay = 1000
uuid = ""
block_engine_urls = [
  "https://frankfurt.mainnet.block-engine.jito.wtf/api/v1",
]
tip_config = { from = 1111, to = 8333 }
dynamic_tip = { enable = true, min_percentile = 10, max_percentile = 85, min = 111, max = 20333 }

[helius]
enabled = false
process_delay = 300
priority_fee_lamports = { from = 111, to = 3333 }
tip_lamports = { from = 200_000, to = 30_000_000 }
dynamic_priority_fee = { enable = true, min_percentile = 10, max_percentile = 85, min = 111, max = 8333 }
dynamic_tip = { enable = true, min_percentile = 10, max_percentile = 85, min = 200_000, max = 100_000_333 }

[helius_swqos]
enabled = false
process_delay = 300
priority_fee_lamports = { from = 100, to = 3333 }
tip_lamports = { from = 5000, to = 5_000_333 }
dynamic_priority_fee = { enable = true, min_percentile = 10, max_percentile = 85, min = 111, max = 6333 }
dynamic_tip = { enable = true, min_percentile = 10, max_percentile = 85, min = 5111, max = 10_000_333 }

[temporal]
enabled = false
uuid = ""
process_delay = 300
priority_fee_lamports = { from = 1111, to = 3333 }
tip_lamports = { from = 1_000_000, to = 20_000_333 }
dynamic_priority_fee = { enable = true, min_percentile = 10, max_percentile = 85, min = 111, max = 6333 }
dynamic_tip = { enable = true, min_percentile = 10, max_percentile = 85, min = 1_000_011, max = 30_000_333 }

[falcon]
enabled = false
uuid = ""
process_delay = 300
priority_fee_lamports = { from = 111, to = 3333 }
tip_lamports = { from = 1_000_000, to = 10_000_333 }
dynamic_priority_fee = { enable = true, min_percentile = 10, max_percentile = 85, min = 111, max = 6333 }
dynamic_tip = { enable = true, min_percentile = 10, max_percentile = 85, min = 1_000_011, max = 30_000_333 }

[circular]
enabled = false
api-key = ""
endpoint = "https://fast.circular.fi/transactions"
process_delay = 300
priority_fee_lamports = { from = 111, to = 3333 }
# Minimum tip_lamports.from is 100_000 lamports.
tip_lamports = { from = 1_000_000, to = 10_033_333 }
dynamic_priority_fee = { enable = true, min_percentile = 10, max_percentile = 85, min = 111, max = 6333 }
dynamic_tip = { enable = true, min_percentile = 10, max_percentile = 85, min = 1_000_011, max = 30_000_333 }

[auto]
enabled = true
refresh_interval_in_secs = 10.0
force_two_mints = true
enable_three_hop = true

[auto.filters]
limit = 2
min_tx_len = 5
duration = 60
min_profit = 200_000_000
min_profit_per_arb = 10000000
min_roi = 0.0
min_volume_lamports = 0
max_volume_lamports = 9_223_372_036_854_775_807
ignore_offchain_bots = false

[auto.markets]
max_pool_len = 4
min_pool_liquidity_lamports = 6_000_000_000
max_pool_liquidity_lamports = 780_000_000_000_000
route_relevance_max_window_secs = 120
route_relevance_half_life_secs = 20
profit_weight = 0.75
count_weight = 0.25

[flashloan]
enabled = true

[rpc]
# You can pass the value directly or via environment variable, for example "$RPC_URL"
url = ""

[wallet]
# You can pass the private key directly or via environment variable, for example "$PRIVATE_KEY"
private_key = ""
