# Example bot configuration.
# Copy this into config.toml and fill in your RPC / key / sender modes.

[stop]
min_balance_lamports = 100_000_000
should_unwrap = true
unwrap_amount_lamports = 200_000_000

[cashback_autoclaim]
enabled = true
claim_threshold_lamports = 100_000_000
check_interval_secs = 3600

# Markets sources from file.
# File format: TOML like `group = [{ mint = "...", markets = ["..."], luts = ["..."] }]`
# If `update_seconds = 0`, the file is read once at startup.
# [[markets_file]]
# enabled = false
# path = "markets.toml"
# update_seconds = 0

# LUT sources from file.
# Supported formats:
# 1. TOML like `luts = ["..."]`
# 2. TXT where the first token on each line is a LUT address
# If `update_seconds = 0`, the file is read once at startup.
# [[lookup_tables_file]]
# enabled = false
# path = "lookup-tables.txt"
# update_seconds = 0

[bot]
# Compute unit limit per transaction
compute_unit_limit = 358_182
dlmm_bin_range_to_search = 20
no_failure_mode = true
merge_mints = true
run_after_simulation_profit = false
log = false

[spam]
enabled = true
process_delay = 300
sending_rpc_urls = [
  "",
]
priority_fee = { from = 1111, to = 3333 }
# If omitted, 100 is used
max_spam_tx_len_after_simulation_success = 100
# If omitted, 1 is used
max_retries = 1

[jito]
enabled = false
process_delay = 1000
uuid = ""
block_engine_urls = [
  "https://frankfurt.mainnet.block-engine.jito.wtf/api/v1",
]
tip_config = { from = 1111, to = 3333 }

[helius]
enabled = false
process_delay = 300
priority_fee_lamports = { from = 1111, to = 3333 }
tip_lamports = { from = 1111, to = 3333 }

[helius_swqos]
enabled = false
process_delay = 300
priority_fee_lamports = { from = 1111, to = 3333 }
tip_lamports = { from = 1111, to = 3333 }

[temporal]
enabled = false
uuid = ""
process_delay = 300
priority_fee_lamports = { from = 1111, to = 3333 }
tip_lamports = { from = 1111, to = 3333 }

[falcon]
enabled = false
uuid = ""
process_delay = 300
priority_fee_lamports = { from = 1111, to = 3333 }
tip_lamports = { from = 1111, to = 3333 }

[auto]
enabled = true
refresh_interval_in_secs = 10
force_two_mints = true

[auto.filters]
limit = 2
min_tx_len = 10
min_pool_wsol_liquidity = 5
max_pool_wsol_liquidity = 76000
duration = 50
min_profit = 100000000
min_profit_per_arb = 1000000
min_roi = 1.0
ignore_offchain_bots = true

[flashloan]
enabled = true

[rpc]
# You can pass the value directly or via environment variable, for example "$RPC_URL"
url = ""

[wallet]
# You can pass the private key directly or via environment variable, for example "$PRIVATE_KEY"
private_key = ""
